# @react-native-firebase kullanıldığı için Firebase config JS env değişkeni
# DEĞİL, native dosyalardan okunur:
#   - android/app/google-services.json   (Firebase Console > Android app)
#   - ios/GoogleService-Info.plist        (Firebase Console > iOS app)
# Bu dosyalar repo köküne konup app.json > ios/android.googleServicesFile
# alanında referans verilir. .gitignore'da zaten dışlanmıştır.
#
# ASLA buraya ANTHROPIC_API_KEY veya başka bir sunucu taraflı secret KOYMAYIN.
# Anthropic API anahtarı sadece /functions içinde Secret Manager üzerinden
# kullanılır (bkz. functions/.env.example).

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_BANNER_IOS=ca-app-pub-3940256099942544/2934735716
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-3940256099942544/1033173712
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=ca-app-pub-3940256099942544/4411468910
EXPO_PUBLIC_ADMOB_NATIVE_ANDROID=ca-app-pub-3940256099942544/2247696110
EXPO_PUBLIC_ADMOB_NATIVE_IOS=ca-app-pub-3940256099942544/3986624511
EXPO_PUBLIC_ADMOB_APP_OPEN_ANDROID=ca-app-pub-3940256099942544/3419835294
EXPO_PUBLIC_ADMOB_APP_OPEN_IOS=ca-app-pub-3940256099942544/5662855259
EXPO_PUBLIC_ADS_TEST_MODE=true
